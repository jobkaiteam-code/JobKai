# JobKai Frontend Environment Variables
# Copy this file to .env and fill in your actual values

# ============================================
# API Configuration
# ============================================

# Backend API Gateway URL
# Development: http://localhost:8000
# Production: https://api.jobkai.app
VITE_API_URL=http://localhost:8000

# ============================================
# Firebase Configuration (Client SDK)
# ============================================

# Get these values from: Firebase Console > Project Settings > Your apps
# Click on the web app (</>) icon to view config

# Firebase API Key (public - safe to expose in frontend)
VITE_PUBLIC_FIREBASE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Firebase Auth Domain
VITE_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com

# Firebase Project ID
VITE_PUBLIC_FIREBASE_PROJECT_ID=your-project-id

# Firebase Storage Bucket
VITE_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app

# Firebase Messaging Sender ID
VITE_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012

# Firebase App ID
VITE_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:xxxxxxxxxxxxxxxxxxxx

# Firebase Measurement ID (optional - for Google Analytics)
VITE_MEASUREMENT_ID=G-XXXXXXXXXX

# ============================================
# Vapi AI Configuration (Voice Interviews)
# ============================================

# Vapi Public Key - For voice-based AI interviews
# Get your key from: https://vapi.ai/dashboard
# Note: This is a PUBLIC key, safe to expose in frontend
VITE_VAPI_PUBLIC_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ============================================
# How to Get Your Firebase Configuration:
# ============================================
#
# 1. Go to https://console.firebase.google.com/
# 2. Select your project (or create a new one)
# 3. Click on Project Settings (gear icon)
# 4. Scroll down to "Your apps" section
# 5. Click on the web app icon (</>)
# 6. Copy the firebaseConfig object values
# 7. Also enable Authentication in Firebase Console:
#    - Go to Authentication > Sign-in method
#    - Enable Email/Password
#    - Add authorized domains (localhost for development)
#
# ============================================
# How to Get Your Vapi AI Key:
# ============================================
#
# 1. Go to https://vapi.ai/
# 2. Sign up for an account
# 3. Go to Dashboard
# 4. Copy your Public Key (starts with a UUID format)
# 5. Note: You need a paid plan for production use
