# API Gateway Environment Variables
# Copy this file to .env and fill in your actual values

# ============================================
# Backend Service URLs
# ============================================

# Footprint Service URL
FOOTPRINT_URL=http://footprint:8001

# Resume Reviewer Service URL  
RESUME_REVIEWER_URL=http://resume-reviewer:8002

# Job Matcher Service URL
JOB_MATCHER_URL=http://job-matcher:8003

# AI Interviewer Service URL
AI_INTERVIEWER_URL=http://ai-interviewer:8004

# ============================================
# Firebase Admin SDK
# ============================================

# Place your Firebase Admin SDK JSON file at:
# backend/api-gateway/jobkai-firebase-adminsdk.json
#
# Download from: Firebase Console > Project Settings > 
# Service Accounts > Generate New Private Key

# ============================================
# API Gateway Settings
# ============================================

# Port (default: 8000)
PORT=8000

# CORS Origins (comma-separated)
CORS_ORIGINS=*

# Rate Limiting
RATE_LIMIT_PER_HOUR=1000

# Environment
ENVIRONMENT=development
