# Footprint Service Environment Variables
# Copy this file to .env and fill in your actual values

# ============================================
# API Configuration
# ============================================

# GitHub API (Public - no key required for basic use)
# For higher rate limits, you can optionally add a GitHub Personal Access Token:
# GITHUB_TOKEN=ghp_your_github_token_here

# Stack Exchange API (Public - no key required)
# For higher rate limits, you can optionally add a Stack Apps key:
# STACK_APPS_KEY=your_stack_apps_key_here

# ============================================
# Service Settings
# ============================================

# Port (default: 8001)
PORT=8001

# Cache settings (optional)
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600

# Rate limiting
MAX_REQUESTS_PER_MINUTE=60

# Environment
ENVIRONMENT=development

# ============================================
# Optional: GitHub Token
# ============================================
#
# To increase GitHub API rate limits:
# 1. Go to https://github.com/settings/tokens
# 2. Generate a new token (classic)
# 3. Select scopes: public_repo, read:user
# 4. Copy token and add to GITHUB_TOKEN above
#
# Note: Without token, rate limit is 60 requests/hour
# With token: 5000 requests/hour
