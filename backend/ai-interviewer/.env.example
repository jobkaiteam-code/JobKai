# AI Interviewer Service Environment Variables
# Copy this file to .env and fill in your actual values

# ============================================
# Google Gemini API Configuration
# ============================================

# Google Gemini API Key - For AI interview generation
# Get your key from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=AIzaSy_your_google_api_key_here

# Gemini Model (default: gemini-2.0-flash-exp)
GEMINI_MODEL=gemini-2.0-flash-exp

# ============================================
# Firebase Configuration
# ============================================

# Place your Firebase Admin SDK JSON file at:
# backend/ai-interviewer/jobkai-firebase-adminsdk.json
#
# Download from: Firebase Console > Project Settings > 
# Service Accounts > Generate New Private Key

# Firestore Collection Names
INTERVIEWS_COLLECTION=interviews
FEEDBACK_COLLECTION=feedback

# ============================================
# Service Settings
# ============================================

# Port (default: 8004)
PORT=8004

# Interview Settings
DEFAULT_QUESTION_COUNT=8
MAX_QUESTION_COUNT=20

# Environment
ENVIRONMENT=development
