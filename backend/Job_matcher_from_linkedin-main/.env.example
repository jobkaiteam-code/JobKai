# Job Matcher Service Environment Variables
# Copy this file to .env and fill in your actual values

# ============================================
# Job API Configuration
# ============================================

# Findwork API Key - For job listings
# Get your key from: https://findwork.dev/developers/
FINDWORK_API_KEY=your_findwork_api_key_here

# ============================================
# Service Settings
# ============================================

# Port (default: 8003)
PORT=8003

# ML Model for job matching
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2

# Max CV file size (in MB)
MAX_CV_SIZE_MB=10

# Default number of job matches
DEFAULT_TOP_N=10

# Job sources (comma-separated)
ENABLED_JOB_SOURCES=findwork,themuse,remoteok

# Environment
ENVIRONMENT=development
