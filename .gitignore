*-firebase-adminsdk-*.json
jobkai-firebase-adminsdk*.json
job-kai-firebase-adminsdk*.json
backend/api-gateway/*-firebase-adminsdk-*.json
backend/ai-interviewer/*-firebase-adminsdk-*.json

# Firebase cache
.firebase/
firebase-debug.log
firestore-debug.log

