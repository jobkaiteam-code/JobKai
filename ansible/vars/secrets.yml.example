---
# Encrypted Variables for JobKai Deployment
# Encrypt this file with: ansible-vault encrypt vars/secrets.yml
# Edit with: ansible-vault edit vars/secrets.yml

# Azure Container Registry Credentials
# Generate this with: kubectl create secret docker-registry acr-secret --docker-server=jobkairegistry.azurecr.io --docker-username=<username> --docker-password=<password> --dry-run=client -o json | jq -r '.data[".dockerconfigjson"]'
acr_docker_config_json: |
  {
    "auths": {
      "jobkairegistry.azurecr.io": {
        "username": "YOUR_ACR_USERNAME",
        "password": "YOUR_ACR_PASSWORD",
        "auth": "BASE64_ENCODED_USERNAME:PASSWORD"
      }
    }
  }

# API Keys
groq_api_key: "YOUR_GROQ_API_KEY"
findwork_api_key: "YOUR_FINDWORK_API_KEY"
google_api_key: "YOUR_GOOGLE_API_KEY"
vapi_public_key: "YOUR_VAPI_PUBLIC_KEY"

# Firebase Configuration
firebase_api_key: "YOUR_FIREBASE_API_KEY"
firebase_auth_domain: "YOUR_PROJECT.firebaseapp.com"
firebase_project_id: "YOUR_PROJECT_ID"
firebase_storage_bucket: "YOUR_PROJECT.appspot.com"
firebase_messaging_sender_id: "YOUR_SENDER_ID"
firebase_app_id: "YOUR_APP_ID"
firebase_measurement_id: "YOUR_MEASUREMENT_ID"

# API Gateway URL (update after deployment or use ingress domain)
api_gateway_url: "http://api.jobkai.yourdomain.com"

# Optional: Set to true to deploy ingress
deploy_ingress: false
